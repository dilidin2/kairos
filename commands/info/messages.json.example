{
  // User-facing chat texts for the info plugin. Every key maps to a
  // template; placeholders use the {name} syntax. Missing keys fall back
  // to the English defaults in main.nim.

  // --- !commands ---
  "commands_header": "{user}, here are all the commands:",

  // --- !help ---
  "help_usage": "{user}, usage: {prefix}help <command>",
  "unknown_command": "{user}, unknown command: {prefix}{name}",
  // suffix appended to the help line when the command has a cooldown
  "help_cooldown": " | cooldown: {s}s",
  // suffix appended to the help line when the command has a daily limit
  "help_attempts": " | max {n} attempts/day",

  // --- !uptime / !ping ---
  "uptime": "{user}, I've been online for {time}",
  "ping": "{user}, pong 🏓"
}
