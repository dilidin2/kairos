{
  // User-facing chat texts for the vanish plugin. Every key maps to a
  // template; placeholders use the {name} syntax. Missing keys fall back
  // to the English defaults in main.nim.

  // --- !vanish ---
  "need_mod": "{user}, I need to be a moderator to use !vanish",
  "broadcaster": "{user}, I can't make the broadcaster vanish",
  "secret": "{user}, i see your secret 🕵️"
}
