{
  // Command metadata. Top-level keys are the canonical command names:
  // do NOT rename them (handlers are wired by name in the code). To
  // translate, only change the "help" text and trophy names/descriptions.
  // If you want a localized command name, add it to the "aliases" array
  // instead of renaming the key.

  "!stock": {
    "help": "list the virtual stocks with prices, trends and remaining supply",
    "aliases": [],
    // Cooldown in seconds (0 = none)
    "cooldown": 5
  },
  "!buy": {
    "help": "buy stocks (!buy <item> <quantity>)",
    "aliases": [],
    "cooldown": 5
  },
  "!sell": {
    "help": "sell stocks (!sell <item> <quantity>)",
    "aliases": [],
    "cooldown": 5
  },
  "!buyall": {
    "help": "buy as many shares as you can afford (!buyall <item>)",
    "aliases": [],
    "cooldown": 5
  },
  "!sellall": {
    "help": "sell all your shares of an item (!sellall <item>)",
    "aliases": [],
    "cooldown": 5
  },
  "!loan": {
    "help": "borrow from the broker, funded by trade fees (!loan [amount])",
    "aliases": ["loan"],
    "cooldown": 5
  },
  "!repay": {
    "help": "repay your loan to the broker (!repay [amount])",
    "aliases": ["repay"],
    "cooldown": 5
  },
  "!portfolio": {
    "help": "show your holdings, total value, PnL and debts",
    "aliases": [],
    "cooldown": 5
  },
  "!broker": {
    "help": "ask the sarcastic broker about the market or your portfolio (!broker <question>)",
    "aliases": [],
    // per-user cooldown; the global rate limit is brokerGlobalCooldownSec
    // in stocks.json
    "cooldown": 15
  }
}
