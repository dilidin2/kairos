{
  // Translatable one-off trophy texts. A value can be a plain message
  // string or an object {name, message}. Placeholders: {user}, {name},
  // {amount}, {item}.
  // First user whose portfolio value reaches the "millionaire" threshold
  // (stocks.json)
  "millionaire": {
    "name": "Stock Millionaire",
    "message": "🏆 {user} is the first to {amount} 🪙 in stocks!"
  },
  // First user whose PnL reaches the "pnlKing" threshold (stocks.json)
  "pnl_king": {
    "name": "PnL King",
    "message": "👑 {user} is the {name}!"
  },
  // Awarded to whoever held a stock when it crashed (negative shock
  // >= crashThreshold, stocks.json)
  "crash_survivor": {
    "name": "Crash Survivor",
    "message": "🦴 {user} survived the {item} crash!"
  }
}
