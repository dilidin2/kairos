{
  // Content lists: one key per category, each a list of strings. A random
  // entry is picked per command. Empty/missing lists make the command
  // reply with a "coming soon" message instead of crashing.
  // The keys are fixed: roasts (!roast), jokes (!joke), truths (!truth),
  // dares (!dare) — only the entries are translatable.
  "roasts": [
    "Your last move was so slow I thought the chat froze.",
    "You're proof that even Wi-Fi can have bad days.",
    "Somewhere, a search engine just got easier by not finding you.",
    "You're the reason the scroll wheel has a reset button.",
    "I'd agree with you, but then we'd both be wrong.",
    "Your name gives me a headache just reading it.",
    "You're not lazy, you're just on energy-saving mode.",
    "If ignorance is bliss, you must be deeply happy.",
    "You brought the 'low' to 'low bar'.",
    "Even a goldfish has more patience than you in a queue.",
    "You're the human equivalent of a 'message sent' that never arrives.",
    "I'm not saying you're slow, I'm saying light could beat you to the moon and back.",
    "Your confidence is doing a lot of work for you today.",
    "You're like a pop-up ad nobody asked for.",
    "Legend says you once lost a staring contest to a loading screen."
  ],
  "jokes": [
    "Why don't scientists attend parties? Because they're a little particle.",
    "I told my wife she was drawing her eyebrows too high. She looked surprised.",
    "What do you call a fake noodle? An impasta.",
    "Why did the scarecrow win an award? He was outstanding in his field.",
    "I'm reading a book about anti-gravity. It's impossible to put down.",
    "Why don't eggs tell jokes? They'd crack each other up.",
    "I used to be a banker, but I lost interest.",
    "What does a coffee shop order instead of an espresso? A depresso.",
    "Why did the bicycle fall over? It was two-tired.",
    "I only know the 25 letters in the alphabet. The other 11 are secret.",
    "What do you call a bear with no teeth? A muffin.",
    "Why did the math book look sad? It had too many problems.",
    "I told a joke about nitrogen last night. No one responded.",
    "What do you call a elephant that balances on one foot? Very careful.",
    "Why did the tomato turn red? Because it saw the salad dressing."
  ],
  "truths": [
    "Admit it: you've googled yourself at 2am.",
    "You still have that one song on repeat you'll never admit to.",
    "Your '5 more minutes' alarm is a lie you tell yourself daily.",
    "You've sent a message you instantly wanted back.",
    "You judge people's photos before you've met them.",
    "You've pretended to be busy to avoid a boring call.",
    "That 'I'll start Monday' has aged you more than the years did.",
    "You type in all caps when you're actually just tired.",
    "You've left a tab open for weeks just in case.",
    "Your 'quick chat' last longer than your grocery runs.",
    "You rehearse arguments in the shower you'll never have.",
    "You know the lyric to a song you'll never play out loud.",
    "You've said 'I'm five minutes away' while still in your pajamas.",
    "Your camera roll is 60% screenshots you meant to save.",
    "You've nodded along to something you didn't understand."
  ],
  "dares": [
    "Post a photo of your most chaotic desk setup.",
    "Do your best impression of a dramatic movie villain.",
    "Tell the chat the last thing you said out loud.",
    "Name 3 things in the room that start with the letter Q.",
    "Do 10 push-ups and post a selfie mid-rep.",
    "Type your next message entirely in caps.",
    "Reveal the last app you opened on your phone.",
    "Do your worst dance move for 10 seconds.",
    "Tell the chat your most embarrassing search from this year.",
    "Pretend to be a news anchor reading the chat aloud.",
    "Say the word 'banana' every time you speak for the next minute.",
    "Show us your least flattering photo.",
    "Do a 30-second stand-up about your breakfast.",
    "Let the chat pick a song and lip-sync it badly.",
    "Reveal the most used emoji in your keyboard."
  ]
}
