{
  // User-facing chat texts for the fun plugin. Every key maps to a
  // template; placeholders use the {name} syntax. Missing keys fall back
  // to the English defaults in main.nim.

  // --- "coming soon" replies (content.json list empty) ---
  "roasts_loading": "The roasts are still loading, hang tight!",
  "jokes_loading": "The jokes are still loading, hang tight!",
  "truths_loading": "The truths are still loading, hang tight!",
  "dares_loading": "The dares are still loading, hang tight!",

  // --- !dare ---
  // label prepended to the dare text
  "dare_label": "your dare:"
}
