{
  // Global user-facing chat texts (core, not plugin-specific). Every key
  // maps to a template; placeholders use the {name} syntax. Missing keys
  // fall back to the English defaults in the code.

  // --- command router ---
  "cooldown": "{user}, {prefix}{command} is on cooldown, retry in {secs} seconds",
  "no_attempts": "{user}, you have no attempts left for: {prefix}{command}",
  // sent when a command handler crashes or has no handler
  "error": "{user}, this is a generic error message, we have no clue why this did not work -.-",
  "mod_required": "{user}, you need a moderator role to use {prefix}{command}",
  "broadcaster_required": "{user}, only the broadcaster can use {prefix}{command}"
}
